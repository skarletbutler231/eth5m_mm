# ---- asset (src/asset.ts): which 5-minute Up/Down market — eth (eth-updown-5m, Chainlink eth/usd, Binance ETHUSDT,
# Coinbase ETH-USD) or btc. The pm2 apps set it too (ecosystem.config.cjs) ----
MM_ASSET=eth

# Copy to .env to override. Every key is optional.
PORT=8040
LISTEN_HOST=127.0.0.1          # 0.0.0.0 to expose on all interfaces (the dashboard is read-only)
UI_PUSH_MS=100                 # dashboard frame cadence; also the replay resolution
# DATA_DIR=data

# fair value model
KAPPA_PRIOR=1.10               # sigma_implied / sigma_base before any window is calibrated
KAPPA_WINDOWS=20
EPS_PRIOR_BPS=0.1              # TWAP-rebuild error prior until 120 reports are scored
EPS_FLOOR_BPS=0.05
VOL_HALF_LIFE_FAST_SEC=120
VOL_HALF_LIFE_SLOW_SEC=1800
VOL_FAST_WEIGHT=0.5
ORACLE_LAG_MS=auto             # or a fixed number of ms
ORACLE_LAG_PRIOR_MS=250
CB_FEED=on                     # Coinbase ETH-USD as a second nowcast venue ("off" = Binance only)
NOWCAST_CB_WEIGHT=auto         # Coinbase's weight in the nowcast blend, calibrated live; a number in [0, 1] pins it (0 = Binance only)
CB_LAG_MS=auto                 # Chainlink-vs-Coinbase lag, calibrated with the weight; or a fixed number of ms
CB_WEIGHT_PRIOR=0.25           # used until the first live fit
CB_LAG_PRIOR_MS=350
SIGMA_MIN_BPS=0.02

# quoter
MM_HALF_SPREAD=0.005          # 0.5c joins the best bid / ask of a 1c book (1c sat a tick behind)
MM_PULL_MOVE=0.005
MM_QUOTE_FROM_SEC=15
MM_QUOTE_UNTIL_LEFT_SEC=10
MM_MIN_EDGE=0.01               # quote only the side FV favours: bid if FV >= mid + this, ask if FV <= mid - this ("off" = both sides)
MM_MAX_MOVE_2S=0.003           # no quotes while FV moved more than this in 2 s ("off" = no motion gate)

# quoting policy (A/B): v1 = the edge on both sides; v2 = de-biased edge to add, lenient exits
MM_POLICY=v5                   # v5 (v4 + the tail guard's vol cap and gamma pull, since 2026-10-22) · v4 (norm1e69: both bids at the touch + takes, ~85-95 fills a window) · cert (certainty maker, late, near-certain token only; "v5" until 2026-10-22) · v3 (follow the market, add on a model-first lead) · v2 · v1 (legacy) · ab = v2 even slots, v1 odd
MM_LEAD_PULL=0.005             # v3: pull the side a lead (FV anchored − mid) of this much runs into ("off" = none)
MM_EDGE_SLOW_SEC=60            # v2: edge = FV − mid less its EMA with this half-life ("off" = raw FV − mid)
MM_EXIT_BLOCK=0.02             # v2: a side that reduces |net| is quoted unless the edge is this far against it
MM_ENTRY_LAM=0.03              # v2: extra edge to add at the position cap, for a 50c contract (scales with |net|/cap and p(1-p))
MM_V2_REDUCE_ONLY_LEFT_SEC=60  # v2: reduce-only from this many s before the close, no edge test on the reducing side
MM_MIN_EDGE_KEEP=0.005         # v2 dead band: a side already working stays on down to this edge (turns on at MM_MIN_EDGE)
MM_PAIR_LOCK_MIN=0.05          # v2 pair-lock: the other token's bid locks at least this a pair vs the held avg cost ("off" = v2 exit rules)

# v4: norm1e69's algorithm (README "v4"). Quotes both tokens at the touch with the inventory skew; no edge, motion or pull gates.
MM_V4_FROM_SEC=5               # v4: quotes and takes start this many s after the open
MM_V4_QUOTE_UNTIL_LEFT_SEC=30  # v4: maker quotes stop this many s before the close (the bots' .env: 90 since 2026-10-30, C2)
MM_V4_REDUCE_ONLY_LEFT_SEC=off # v4/v5 closing only: from this many s before the close, only the side that reduces |net| (180 = from 120 s; tag +ro<s>)
MM_V4_TAKE_UNTIL_LEFT_SEC=60   # v4: takes stop this many s before the close (the 60 s settlement average starts)
MM_V4_FLOW_IMB=0.7             # v4 flow take: lift a token's ask at an L1 imbalance (bid - ask)/(bid + ask) of this toward it ("off" = none)
MM_V4_FLOW_THIN=100            # v4 flow take: ...when that ask holds at most this many shares
MM_V4_FV_SLACK=0.01            # v4 flow take: ...unless the anchored FV is more than this under the ask
MM_V4_REBAL_NET=60             # v4 rebalance take: buy the short token at its ask when |net| reaches this ("off" = none)
MM_V4_FLOW_COOLDOWN_MS=10000   # v4: minimum time between two flow takes (a rebalance only waits for the last take to land)

# cert: certainty maker (MM_POLICY=cert, "v5" until 2026-10-22; README "cert"). Late in the window, bids only the near-certain token at E[V | a sell] - edge; held to settlement.
MM_CERT_FROM_LEFT_SEC=120      # cert: quotes start this many s before the close
MM_CERT_UNTIL_LEFT_SEC=1       # cert: ...and stop this many s before it
MM_CERT_MIN_P=0.99             # cert: the favourite's probability (the lower of model FV and anchored FV) must be at least this
MM_CERT_P_CAP=0.999            # cert: ...and is capped here for pricing and sizing
MM_CERT_KAPPA=1.5              # cert Glosten-Milgrom: informed sellers per uninformed one; E[V | sell] = p - kappa*(1 - p)
MM_CERT_MIN_EDGE=0.003         # cert: the bid sits at least this under E[V | sell]
MM_CERT_IMPROVE_TICKS=1        # cert: at most this many ticks over the favourite's best bid
MM_CERT_PULL=0.002             # cert speed bump: pull the bid when the favourite's model FV fell this much in 2 s ("off" = re-pricing only)
MM_CERT_ORDER_SIZE=100         # cert: shares a bid
MM_CERT_MAX_POS=200            # cert: cap on the favourite held net, shares
MM_CERT_FLIP_BUDGET=0.4        # cert: ...and on its expected flip loss, (1 - p) * price * shares, USDC

# queue race (v4): a bid that joined an existing level leaves when it is losing the race for that level (README "Queue race")
MM_RACE_LEVEL=0.5              # cancel when the level (others at its price) falls below this share of its size when the bid went live ("off" = none)
MM_RACE_SHARE=0.2              # ...or its side's share of the touch, level / (level + opposite best), falls below this; no new bid joins under it ("off" = none)
MM_RACE_HOLD_MS=1000           # after a race cancel, that side does not rejoin the same price for this long
MM_RACE_OUTBID=off             # "on" = cancel a bid once it is outbid (it was the touch while live, now behind it); off since 2026-10-11 (worse on paper)

# ---- flow FV (src/model/flowFv.ts, README "Flow FV") ----
FLOW_FV=off                    # on = v4 quotes centre on mid + FLOW_FV_SCALE x the predicted 2 s mid move; ab = even 5-minute slots only (tag +ffv); off = recorded only
FLOW_FV_SCALE=2                # multiplier on the prediction (2 was best on held-out days)
FLOW_FV_SCALE_RISE=            # per-side: the bid on the token the prediction says will rise centres on mid + this x pred (empty = FLOW_FV_SCALE; tag +kr<x100>)
FLOW_FV_SCALE_FALL=            # ...and the bid on the other token on mid + this x pred (empty = FLOW_FV_SCALE; tag +kf<x100>)
FLOW_FV_MODEL=models/flowfv-h2.json
PERP_FEED=on                   # Binance USD-M perp bookTicker (the model's strongest input); off = its features go missing
# CryptoStruct relay of the Binance top of book (https://cryptostruct.com/docs/realtime.md), direct Binance as the fallback:
# perp | spot | perp,spot | off. Each is one socket; a key holds 3 per host (more in packs of 5 on the account page).
CRYPTOSTRUCT_FEEDS=off
# the key from cryptostruct.com/account/realtime, in .env (a shell-only export is dropped; no comment on its line)
CRYPTOSTRUCT_REALTIME_API_KEY=
CRYPTOSTRUCT_HOST=lon1.cryptostruct.com
# CRYPTOSTRUCT_PERP_ID=0         # unset = the asset's preset (BTCUSDT perp 67824); 0 = looked up by symbol (ETHUSDT)
# CRYPTOSTRUCT_SPOT_ID=          # empty = looked up in the instrument directory at boot
# Chainlink: PolyBolt (wss://ws-live-v2.polymarket.com/ws, ~200 ms ahead of RTDS, same values) or the legacy RTDS.
# auto = PolyBolt when POLYBOLT_API_KEY is set. A feed-only CLOB key: node ../btc5m_mm_bot/tools/polybolt/feedkey.mjs (an
# empty EOA, not the trading wallet). From 2026-11-30 00:00 UTC PolyBolt also wants CHAINLINK_API_KEY
# (institutional.polymarket.com/request-chainlink-api-key); refused → RTDS for 10 min, then retried. No comment on key lines.
CL_FEED=auto
POLYBOLT_API_KEY=
POLYBOLT_SECRET=
POLYBOLT_PASSPHRASE=
CHAINLINK_API_KEY=

# inventory
MM_ORDER_SIZE=25               # shares per side
MM_MAX_POSITION=100            # cap on |net Up shares| per window
MM_CAP_PENDING=off             # on: the cap also counts orders still cancelling, so a replace chain in a sweep can't overshoot it
# session schedule (src/control.ts): order size a side (cap 2×), size/cap, or stop by the UTC hour a window opens in; ranges
# include both ends, 22-2 wraps midnight, * = every other hour. Read again at every window (ecosystem env, then .env). off = none
# MM_SESSIONS=0-3=20,13-16=20,4-8=stop,*=10
MM_SKEW_AT_MAX=0.02            # centre shift at the cap for a 50c contract (scales with p(1-p))
# market regime refit (src/regime.ts, tag +rg, README "Market regime refit"; 2026-11-14): at each window's open the last
# MM_REGIME_WINDOWS closed windows decide CALM or BUSY, and the window runs on that regime's cap and size (unset = the two above)
MM_REGIME=off                  # on: refit the cap / order size to the market regime at each window
MM_REGIME_WINDOWS=6            # trailing windows the regime is measured over (6 = 30 min)
MM_REGIME_MIN_WINDOWS=3        # fewer measured than this = UNKNOWN = MM_MAX_POSITION / MM_ORDER_SIZE
MM_REGIME_BUSY_SPR=0.0116      # BUSY when the trailing mean Up spread (first 180 s of each window) is at least this; off = unused
MM_REGIME_BUSY_VOL=off         # or when the trailing the asset's 1 s volatility (bp) is at least this
MM_REGIME_CALM_CAP=            # cap in a CALM market (unset = MM_MAX_POSITION)
MM_REGIME_CALM_SIZE=           # order size in a CALM market (unset = MM_ORDER_SIZE)
MM_REGIME_BUSY_CAP=            # cap in a BUSY market
MM_REGIME_BUSY_SIZE=           # order size in a BUSY market
# hour-of-day regimes (src/hourRegime.ts, tag +hr, README "Hour-of-day regimes"; 2026-11-17): each window runs on (on) or only
# records (shadow) the config of its opening UTC hour's regime, from the table tools/hourregime/walkforward.py writes
MM_HOUR_REGIME=off             # off | shadow (index entry hourRegime, log line; trades the base config) | on (replaces MM_REGIME)
MM_HOUR_REGIME_FILE=config/hour-regimes.json
MM_HOUR_REGIME_LIVE=off        # on: let the live app apply it (MM_HOUR_REGIME=on live without this runs shadow)
MM_HOUR_REGIME_CAP_MAX=40      # a regime's MM_MAX_POSITION is clamped to this
MM_HOUR_REGIME_SIZE_MAX=20     # a regime's MM_ORDER_SIZE is clamped to this
# tail guard (src/guard.ts, v4 / v5, tag +guard; README "Tailguard agent", "v5"): every rule off until its trigger knob is set,
# except v5's two (MM_POLICY=v5 defaults): the gamma pull 0.6 on the adding side and the vol cap 0.3 ("off" turns one off)
MM_GUARD_TV_MS=10000           # lookback of the mid's total variation (whipsaw rule, vol cap), ms
MM_WHIP_TV=off                 # pull bids while that total variation (>= 1-tick steps) is at least this, price units
MM_WHIP_HOLD_MS=5000           # ... and for this long after its last trigger
MM_WHIP_SIDE=both              # both | adding (only the side that adds to |net|)
MM_GAMMA_PULL=0.6              # pull while phi(Phi^-1(centre)) * sqrt(300 s / time left) is at least this (v5 default 0.6, v4 off)
MM_GAMMA_SIDE=adding           # both | adding (v5 default adding, v4 both)
MM_JUMP_BPS=off                # the Binance perp moved this many bp within MM_JUMP_MS: pull the bid that move runs into (.env: 1 since 2026-10-30, C2)
MM_JUMP_MS=300
MM_JUMP_HOLD_MS=1000
MM_INV_STOP_NET=off            # |net| >= this and the held token's mid MM_INV_STOP_LOSS under its average cost: no adding
MM_INV_STOP_LOSS=0.05
MM_INV_STOP_HOLD_MS=10000
MM_CAP_VOL_TV=0.3              # once the total variation passes this, the cap shrinks to cap * max(MM_CAP_VOL_FLOOR, MM_CAP_VOL_TV / TV) (v5 default 0.3, v4 off)
MM_CAP_VOL_FLOOR=0.25
# pair cost (src/paircost.ts, v4 / v5, tag +pc; README "Pair cost"): every rule off until its trigger knob is set
MM_PC_TARGET=off               # completion cap: while holding, the bid that pairs the held token off is priced so a pair costs at most this
MM_PC_RACE=on                  # off: a pairing bid the cap holds back rests at the cap price outside the queue race
MM_PC_STOP=off                 # the window's pairs cost this much or more on average: the side that adds to |net| is off for the window
MM_PC_WIDEN=off                # the adding side steps back this many ticks per 1c the window's pair cost is over MM_PC_WIDEN_FROM
MM_PC_WIDEN_FROM=1.0
MM_PC_WIDEN_MAX=5              # ticks
MM_PC_MIN_PAIRS=20             # pairs merged in the window before the stop and the widen read its pair cost
MM_PC_HOLD_P=off               # carry: the held token's centre at this or more and the pair cost under MM_PC_HOLD_MAX: no bid pairs it off
MM_PC_HOLD_MAX=1.03
MM_PC_HOLD_EXIT=0.5            # ... until the favourite falls back to this
# excess takes (src/excess.ts, v4 / v5, tag +xs; README "Inventory team"): a fill-and-kill BUY of the short token that only
# ever reduces |net|; every trigger off until its knob is set
MM_XS_EDGE=off                 # the short token's centre - the limit - the taker fee is at least this (price units)
MM_XS_JUMP_BPS=off             # the Binance perp moved this many bp within MM_XS_JUMP_MS the short token's way (.env: 1 since 2026-10-30, C2)
MM_XS_JUMP_MS=300
MM_XS_LATE_SEC=off             # this many s or less to the close: close the excess instead of carrying it
MM_XS_STOP_LOSS=off            # the held token's mid this much or more under its average cost: close it
MM_XS_HOLD_P=off               # late and stop keep a held token whose centre is at least this (carried to settlement)
MM_XS_NET=5                    # |net| needed for any excess take
MM_XS_KEEP=0                   # shares left unpaired by a take
MM_XS_MAX_SH=20                # shares per take at most
MM_XS_SLIP=0                   # the limit = the ask + this (a price: 0.10 = 10¢), at most MM_XS_MAX_PX
MM_XS_MAX_PX=0.95
MM_XS_COOLDOWN_MS=2000         # between excess takes
MM_XS_FROM_SEC=5
MM_XS_UNTIL_LEFT_SEC=10
MM_XS_FAST=on                  # also on the 10 ms decisions between frames (MM_DECIDE_STEP_MS)
MM_REDUCE_ONLY_LEFT_SEC=30     # v1: last N s before the close: only the side that reduces inventory

# order management (paper: simulated against the live book, nothing is sent)
MM_MODE=paper                  # paper | shadow (shadow = quotes are only drawn, as in v0.1) | live (REAL orders: README "Live mode")
MM_REQUOTE_MIN_MS=1000         # a working order only LESS aggressive than the target keeps its queue spot this long
MM_TOLERATE_TICKS=1            # a working order up to this many ticks MORE aggressive than the target stays...
MM_TOLERATE_EDGE=0.0025        # ...while still this far inside the reservation (0 ticks = replace at once)
MM_STAY_AT_TOUCH=on            # a working order at the best price of its book is not moved up to a better target
PAPER_START_USDC=1000          # starting balance of a new paper account (delete data/paper/state.json to reset)
PAPER_LATENCY_MS=35            # one-way place / cancel latency (AWS eu-west-1, 2026-10-13: place 36 ms, cancel 29 ms median, send → public feed; Helsinki was 65)
PAPER_STEP_MS=10               # the paper exchange also matches every this many ms between the 100 ms frames (fills only; 0 = at frames only)
MM_DECIDE_STEP_MS=0            # v4: re-run the quote and the order manager every this many ms between frames, after the paper step's fills (0 = at frames only; the bot runs 10)
PAPER_MAKER_REBATE=0.2         # maker rebate credited on each maker fill: this share of the taker fee 0.07*p*(1-p) (0 = none)
PAPER_TAKER_DELAY_MS=150       # Polymarket's taker delay on crypto markets, added to a taker order's latency
# PAPER_TAKE_MS=300            # a paper take's send → match, the delay included (unset: the two above; live = drawn from the live takes' answers)
PAPER_FILL_MODEL=sweep         # sweep (calibrated on real fills, README "Fill model calibration") | queue (the model before 2026-10-13)
PAPER_SWEEP_PLACE_MS=28        # sweep: send → at the venue (eu-west-1; Helsinki 50). Re-measure after a move: tools/latency-test.ts
PAPER_SWEEP_CANCEL_MS=55       # sweep: the cancel's 21 ms to the venue + a 32 ms conservative margin (Helsinki 70)
PAPER_SWEEP_BOOKLAG_MS=35      # sweep: the taker fills against the book this long before its print (venue-side, not location)
PAPER_SWEEP_FEEDLAG_MS=13      # sweep: Polymarket feed lag inside the running bot (eu-west-1; Helsinki 37)
PAPER_SWEEP_LAT=live           # sweep: place/cancel times drawn per order from the live MM's own orders (README "Paper vs live, 5 windows"), default since 2026-10-23:
#                                live: calm tables (29 / 26 ms median), swept ones (83 / 70) for orders within 150 ms of a taker whose sweep reached our price and
#                                for PAPER_SWEEP_LAT_SWEPT_MS after it, or 1 s after a 6¢ target move | fixed: the two constants above (the default before) | busy: always swept
# PAPER_SWEEP_LAT_SWEPT_MS=500  # live: a sweep that reached our price keeps the venue busy this long after the taker arrived
# PAPER_SWEEP_LAT_MOVE=0.06     # live: a target move this big within PAPER_SWEEP_LAT_LOOKBACK_MS (200) makes the venue busy...
# PAPER_SWEEP_LAT_BUSY_MS=1000  # live: ...for this long
# PAPER_SWEEP_LAT_TAU_MS=2000   # the venue's state decays over this; PAPER_SWEEP_LAT_SEED (1) repeats the draws
# PAPER_SWEEP_LAT_CALM=0.35     # only with flat test tables: calm = busy × this
PAPER_SELF_CROSS=on            # the venue's post-only check sees our own resting orders: a bid crossing our own bid on the other token is refused (off = before 2026-10-23)
PAPER_FILL_HEARD_MS=80         # a fill reaches the trader this long after the venue's match (the user channel's delay live; 0 = as it prints, before 2026-10-23)
PAPER_PENDING_UNTIL=ack        # MM_CAP_PENDING stops counting a cancelling order at the venue's cancel answer (ack, as live) | tail: once no print can reach it (~355 ms, before 2026-10-23)

MAX_GOOD_SPREAD=0.03
MAX_BOOK_AGE_MS=3000

# ---- move signal: WS ws://LISTEN_HOST:PORT/signal for other bots (README "Move signal") ----
SIGNAL_MIN_MOVE=0.03           # target-quote move that fires a signal, Up price units ("off" = heartbeats only)
SIGNAL_LOOKBACK_MS=100         # ...measured against the target this long ago
SIGNAL_LEAD_ONLY=on            # only moves the book has not made yet and the flow forecast points to (off = every move)
SIGNAL_MIN_PRED=0.035          # ...and the forecast backs by at least this (off = no floor)
SIGNAL_TOP=0.3333              # ...and only the strongest this share of the last 100 moves found, by forecast (off = the floor alone)
SIGNAL_COOLDOWN_MS=1000        # no second signal in the same direction for this long
SIGNAL_HEARTBEAT_MS=1000       # {"type":"hb"} to every subscriber this often
# fast move signal on WS /signal-fast: the pair's detector (lead-only, no forecast threshold) with a 100 ms lookback
FAST_SIGNAL_MIN_MOVE=0.05      # target-quote move that fires it ("off" = heartbeats only)
FAST_SIGNAL_LOOKBACK_MS=100    # ...measured against the target this long ago
FAST_SIGNAL_LEAD_ONLY=on       # as SIGNAL_LEAD_ONLY
FAST_SIGNAL_MIN_PRED=off       # as SIGNAL_MIN_PRED (off = no floor)
FAST_SIGNAL_TOP=off            # as SIGNAL_TOP (off = no cut)
FAST_SIGNAL_COOLDOWN_MS=1000   # no second signal in the same direction for this long

# ---- pair trade: no market making, the move signal traded in Up+Down pairs (README "Pair trade"; pm2 app eth5m-pair) ----
PAIR_TRADE=off                 # on = pairs instead of quotes (pm2 eth5m-pair paper, eth5m-pair-live real)
PAIR_MIN_MOVE=0.06             # target move that opens a pair (leading the book as PAIR_LEAD says, flow forecast on its side)
PAIR_LOOKBACK_MS=200           # ...within this long (the /signal feed keeps SIGNAL_LOOKBACK_MS)
PAIR_SIGNAL=own                # own: the two lines above · fast: the /signal-fast detector (FAST_SIGNAL_*)
PAIR_LEAD=unmoved              # unmoved: the book mid did not move in the lookback · excess: still or moved the target's way, the target PAIR_MIN_MOVE more
PAIR_MOVE=both                 # both: the average of the target's bid and ask moves · free: only the sides post-only did not hold a tick off the book (a one-sided jump counts in full)
PAIR_LEG1=maker                # maker: post-only bid at the token's best bid · taker: fill-and-kill up to PAIR_SLIP over its ask
PAIR_MAKER_MS=500              # a maker leg 1 is cancelled this long after it was sent
PAIR_MAX_QUEUE=off             # ...or not sent when more shares than this (e.g. 300) already rest at its bid; off = always
PAIR_SLIP=0.01                 # taker leg 1: fill-and-kill at most this over the token's ask at the signal
PAIR_HOLD_MS=2000              # leg 2 (the other token, as a taker) this long after leg 1 filled (with PAIR_CLOSE_EDGE: at the latest)
PAIR_CLOSE_EDGE=off            # leg 2 sooner, once the pair would lock this much a pair (e.g. 0.10) at the other token's ask after both fees; off = at PAIR_HOLD_MS
PAIR_STOP_MOVE=off             # leg 2 at once if the Up mid moves this far (e.g. 0.01) against leg 1 within PAIR_STOP_MS of its fill; off = no stop
PAIR_STOP_MS=3000              # ...how long after leg 1's fill the stop watches
PAIR_L2_MODEL=off              # leg-2 model: at leg 1's fill P(Up mid against it in 5 s); on = leg 2 at once at P ≥ PAIR_L2_MODEL_P · ab = even 5-min slots only (odd = control) · off = not loaded
PAIR_L2_MODEL_P=0.5            # ...the P that sends leg 2 at once
PAIR_L2_MODEL_FILE=models/l2-h5.json   # ...the model (tools/l2model)
PAIR_SIZE=10                   # shares a leg
PAIR_UNTIL_SEC=240             # no new pair this far into the window
PAIR_MAX_PRICE=0.75            # no leg 1 on a token asking more
PAIR_CLOSE_SLIP=0.05           # leg 2 walks the other token's asks up to this over its best
PAIR_CLOSE_LEFT_SEC=15         # leg 2 at once this close to the end, whatever the hold

# ---- follow trade: no market making, another bot's maker fills followed by a taker buy (README "Follow trade"; pm2 eth5m-mm-challenger) ----
FOLLOW_TRADE=off               # on = follow instead of quotes (paper only; the challenger's ecosystem env sets it)
FOLLOW_URL=ws://127.0.0.1:8040/signal-fills   # the source bot's fill feed (eth5m-mm-bot)
FOLLOW_KINDS=nocancel,race     # which source fills: nocancel (resting, no cancel sent) · race (a race cancel in flight)
FOLLOW_SIZE=0                  # shares a take: 0 = the source fill's
FOLLOW_MAX_SH=20               # ...at most this a take
FOLLOW_MAX_WIN_SH=off          # ...and this a window (off = no cap)
FOLLOW_SLIP=0.02               # fill-and-kill up to the token's ask + this
FOLLOW_MAX_PX=0.95             # no take on a token asking more
FOLLOW_MAX_AGE_MS=1000         # a signal heard later than this after it was sent is dropped
FOLLOW_FROM_SEC=0              # none before this far into the window
FOLLOW_UNTIL_LEFT_SEC=10       # none this close to the end

# ---- live (MM_MODE=live, README "Live mode"; the pm2 app eth5m-mm-live sets MM_MODE, PORT, DATA_DIR and sizes itself) ----
# The private key, the L2 API creds and the Relayer API key are NOT set here: they live only in the encrypted wallet
# vault (wallet.vault; npm run vault:init), opened by a passphrase typed at startup. Live refuses to start while any of
# them is still in this file. VAULT_FILE= overrides the vault's path.
# POLYMARKET_FUNDER_ADDRESS=0x... # the Deposit Wallet the fills settle into
# POLYMARKET_RELAYER_API_KEY_ADDRESS=  # the address the Relayer API key (in the vault) was issued for: gasless merges / redeems;
#                                      # key or address missing = merges and redeems are not sent
LIVE_MAX_LOSS=60               # no new orders, every working one cancelled, once PnL (equity − start) is this far down
LIVE_POST_COPIES=1             # live: each order signed once and posted this many times at once (1-10); the venue places it once
LIVE_EARLY_CANCEL=off          # live: a cancel decided while the post is in flight goes at once by the signed order id (README "Early cancel";
#                                eth5m-mm-live has it on in ecosystem.config.cjs since 2026-10-30)
# PAPER_EARLY_CANCEL=          # the same on paper (with PAPER_SWEEP_LAT drawn times); defaults to LIVE_EARLY_CANCEL
LIVE_CHAIN=off                 # live: the bot's own gasless merge / redeem jobs (also need the Relayer key). Off since 2026-11-13: they all
#                                fail on SDK 0.6.0 (Gamma dropped marketMakerAddress) and Polymarket redeems settled windows itself
LIVE_MAX_PLACES_10S=200        # runaway guard: more orders than this in 10 s pauses placing for 10 s (paper +10ms peaks 126)
